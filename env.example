# Copy real values into Vercel: Project → Settings → Environment Variables.
# Do not commit a filled-in .env file to GitHub.

# platform.openai.com -> API Keys
OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxx

# Optional. Defaults to gpt-4o-mini if not set. gpt-4o-mini is cheap and
# fast and works well for this app; switch to gpt-4o for higher quality
# at a higher per-call cost.
OPENAI_MODEL=gpt-4o-mini

# The code YOU type to unlock the admin panel. This is checked inside the
# serverless function (server-side), never shipped to the browser.
ADMIN_CODE=Yerzhan_2005

# From your Supabase project: Settings -> API
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co

# From the SAME page — the "service_role" secret key, NOT the "anon" key.
# This key bypasses row-level security, so it must stay server-side only —
# never put it in index.html or any frontend code.
SUPABASE_SERVICE_ROLE_KEY=eyJxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
